{
  "name": "ep-github-actions",
  "private": true,
  "description": "TypeScript actions of the Evolution-Perspectives organization .github repository",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rollup --config rollup.config.mjs",
    "test": "NODE_NO_WARNINGS=1 node --test \"actions/*/src/*.test.ts\" \"lib/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.19.2",
    "rollup": "^4.67.5",
    "tslib": "^2.9.1",
    "typescript": "~5.9.3"
  }
}
